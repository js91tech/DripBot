# SQLite for local/demo. For production, switch Prisma to PostgreSQL
# (see README) and use a hosted URL such as Neon, Supabase, or Railway:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/commercepulse?sslmode=require"
DATABASE_URL="file:./dev.db"

# Optional live enrichment. The app always works with mock fallbacks.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
SERPAPI_KEY=""
